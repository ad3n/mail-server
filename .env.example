STALWART_HOSTNAME=mail.example.com
# Public HTTPS origin used to open admin (no /admin path).
# Leave empty to use the configured server hostname; include any non-default port.
# Example: https://mail.example.com or https://mail.example.com:8443
STALWART_PUBLIC_URL=
# Keep the edition consistent with the existing database.
# AGPL3/SEL (original Docker edition): sqlite postgres enterprise
# AGPL3-only: sqlite postgres
STALWART_FEATURES="sqlite postgres enterprise"
# Generate a password with: openssl rand -hex 32
POSTGRES_PASSWORD=
