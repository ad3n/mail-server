#!/bin/sh
set -eu
cd "$(dirname "$0")"

smtp_ready() { nc -z -w 1 127.0.0.1 1465 >/dev/null 2>&1; }

if ! smtp_ready; then
    echo "Menjalankan Stalwart lokal untuk tes..."
    .stalwart-local/start.sh >.stalwart-local/logs/tes-email.log 2>&1 &
    server_pid=$!
    trap 'kill "$server_pid" 2>/dev/null || true; wait "$server_pid" 2>/dev/null || true' EXIT
    trap 'exit 130' INT TERM
    attempts=0
    until smtp_ready; do
        if ! kill -0 "$server_pid" 2>/dev/null || [ "$attempts" -ge 30 ]; then
            echo "Stalwart gagal siap. Periksa .stalwart-local/logs/tes-email.log." >&2
            exit 1
        fi
        sleep 1
        attempts=$((attempts + 1))
    done
fi

python3 resources/scripts/test_local_mail.py "$@"
