-  return apiFetchJson<Schema>('/api/schema', { signal });
+export async function fetchSchema(signal?: AbortSignal): Promise<Schema> {
+  const schema = await apiFetchJson<Schema>('/api/schema', { signal });
+  const management = schema.layouts.find(layout => layout.name === 'Management');
+  const directory = management?.items.find(item => 'container' in item && item.container.name === 'Directory');
+  if (directory && 'container' in directory) {
+    const items = directory.container.items;
+    const oauth = items.findIndex(item => item.type === 'link' && item.viewName === 'x:OAuthClient');
+    items.splice(oauth < 0 ? items.length : oauth + 1, 0, {
+      type: 'link', name: 'Apps', viewName: 'CustomComponent/IntegrationApps',
+    });
+  }
+  return schema;
 }
 
